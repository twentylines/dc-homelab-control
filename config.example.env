# Homelab Control local-compose configuration.
# Copy this file to config.env, fill the required values, and keep config.env
# private. The installer refuses to start until the required values are set.

# Required: generate a long random value (at least 32 characters).
CONTROL_TOKEN=replace-with-a-long-random-controller-token

# Required Discord application settings.
DISCORD_TOKEN=replace-with-your-discord-bot-token
DISCORD_CLIENT_ID=replace-with-your-application-id
DISCORD_GUILD_ID=replace-with-your-primary-server-id
DISCORD_OWNER_ID=replace-with-your-discord-user-id

# Optional additional servers, administrators, and guests.
DISCORD_GUILD_IDS=
DISCORD_ADMIN_USER_IDS=
DISCORD_ADMIN_ROLE_IDS=
DISCORD_GUEST_USER_IDS=
DISCORD_GUEST_ROLE_IDS=

# Identity and safety defaults.
BOT_NAME=Homelab Control
SERVER_NAME=
TIME_ZONE=UTC
SERVICE_CONTROL_MODE=opt-out

# Optional signed-release source for the bot's own update and rollback controls.
# The host bridge must also be configured; a blank repository keeps this check quiet.
HOMELAB_CONTROL_REPOSITORY=
HOMELAB_CONTROL_VERSION=0.3.22c
HOMELAB_CONTROL_RELEASE_CHANNEL=stable
HOMELAB_CONTROL_RELEASE_ASSET=

# Host paths used by compose.local.yml. The default paths are deliberately
# local to this checkout; change them when Docker lives on a separate host.
APP_DATA_DIR=./data
HOST_DATA_PATH=./data/host-app-data
MEDIA_PATH=./media
MAINTENANCE_DIR=./data/maintenance
HOST_SSD_LABEL=Application data
HOST_MEDIA_LABEL=Media

# Optional discovery/completeness contracts. Blank means auto-detect only.
MEDIA_REQUIRED_PROVIDERS=
MEDIA_STACK_PROFILE=auto
NETWORK_REQUIRED_PROVIDERS=

# Optional read-only media and network integrations.
JELLYFIN_BASE_URL=
JELLYFIN_API_KEY=
JELLYFIN_USER_ID=
PLEX_BASE_URL=
PLEX_TOKEN=
PIHOLE_BASE_URL=
TECHNITIUM_BASE_URL=
ADGUARD_BASE_URL=
SCRUTINY_URL=

# Minecraft backends. In auto mode the bot prefers a configured panel and
# otherwise falls back to read-only Docker discovery.
MINECRAFT_BACKEND=auto
CRAFTY_BASE_URL=
CRAFTY_API_TOKEN=
CRAFTY_ALLOW_INSECURE_TLS=false
PTERODACTYL_BASE_URL=
PTERODACTYL_API_TOKEN=
PELICAN_BASE_URL=
PELICAN_API_TOKEN=

# Optional Wake-on-LAN favourite and weekly report destination.
WAKE_DEFAULT_LABEL=
WAKE_DEFAULT_MAC=
WAKE_BROADCAST=255.255.255.255
WEEKLY_REPORT_WEBHOOK_URL=
WEEKLY_REPORT_ENABLED=true

# The bot reads this file inside the container. Do not change unless the
# compose mount is changed as well.
HOMELAB_CONTROL_CONFIG_FILE=/run/secrets/homelab-control/config.env
