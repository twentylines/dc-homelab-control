{
  "$schema": "../app-info-schema.json",
  "id": "homelab-control",
  "name": "Homelab Control",
  "available": true,
  "categories": ["utilities", "automation"],
  "description": "A private Discord control panel that discovers the containers and homelab services you actually run, then presents safe health, storage, media, network and Docker controls.",
  "short_desc": "Universal, read-first Discord control panel for homelabs",
  "author": "Homelab Control community",
  "source": "https://github.com/twentylines/dc-homelab-control",
  "website": "https://github.com/twentylines/dc-homelab-control",
  "exposable": false,
  "no_gui": true,
  "supported_architectures": ["amd64", "arm64"],
  "tipi_version": 1,
  "version": "0.3.19",
  "dynamic_config": true,
  "deprecated": false,
  "force_expose": false,
  "generate_vapid_keys": false,
  "force_pull": false,
  "form_fields": [
    { "type": "random", "label": "Internal controller token", "max": 96, "min": 48, "required": true, "env_variable": "CONTROL_TOKEN" },
    { "type": "password", "label": "Discord bot token", "max": 200, "min": 20, "required": true, "env_variable": "DISCORD_TOKEN" },
    { "type": "text", "label": "Discord application ID", "max": 30, "min": 15, "required": true, "env_variable": "DISCORD_CLIENT_ID" },
    { "type": "text", "label": "Primary Discord server ID", "max": 30, "min": 15, "required": true, "env_variable": "DISCORD_GUILD_ID" },
    { "type": "text", "label": "Additional server IDs (comma-separated, optional)", "max": 1000, "min": 0, "required": false, "env_variable": "DISCORD_GUILD_IDS" },
    { "type": "text", "label": "Your Discord user ID", "max": 30, "min": 15, "required": true, "env_variable": "DISCORD_OWNER_ID" },
    { "type": "text", "label": "Administrator user IDs (comma-separated, optional)", "max": 1000, "min": 0, "required": false, "env_variable": "DISCORD_ADMIN_USER_IDS" },
    { "type": "text", "label": "Administrator role IDs (comma-separated, optional)", "max": 1000, "min": 0, "required": false, "env_variable": "DISCORD_ADMIN_ROLE_IDS" },
    { "type": "text", "label": "Guest user IDs (read-only + Wake-on-LAN, optional)", "max": 1000, "min": 0, "required": false, "env_variable": "DISCORD_GUEST_USER_IDS" },
    { "type": "text", "label": "Guest role IDs (read-only + Wake-on-LAN, optional)", "max": 1000, "min": 0, "required": false, "env_variable": "DISCORD_GUEST_ROLE_IDS" },
    { "type": "text", "label": "Bot display name (optional)", "max": 80, "min": 0, "required": false, "env_variable": "BOT_NAME" },
    { "type": "text", "label": "Server display name (optional; hostname is used otherwise)", "max": 80, "min": 0, "required": false, "env_variable": "SERVER_NAME" },
    { "type": "text", "label": "Time zone (optional; UTC by default)", "max": 64, "min": 0, "required": false, "env_variable": "TIME_ZONE" },
    { "type": "text", "label": "Service control mode: opt-in or opt-out (optional; opt-in by default)", "max": 16, "min": 0, "required": false, "env_variable": "SERVICE_CONTROL_MODE" },
    { "type": "text", "label": "Advanced config file path (optional; one KEY=VALUE per line)", "max": 500, "min": 0, "required": false, "env_variable": "HOMELAB_CONTROL_CONFIG_FILE" },
    { "type": "text", "label": "GitHub repository for bot updates (optional; owner/repository)", "max": 180, "min": 0, "required": false, "env_variable": "HOMELAB_CONTROL_REPOSITORY" },
    { "type": "text", "label": "Release archive filename (optional; only if the release has multiple archives)", "max": 180, "min": 0, "required": false, "env_variable": "HOMELAB_CONTROL_RELEASE_ASSET" },
    { "type": "text", "label": "Required media providers (optional; e.g. jellyfin,seerr,sonarr,radarr,prowlarr,qbittorrent)", "max": 500, "min": 0, "required": false, "env_variable": "MEDIA_REQUIRED_PROVIDERS" },
    { "type": "text", "label": "Media profile: auto, full, minimal or none (optional)", "max": 16, "min": 0, "required": false, "env_variable": "MEDIA_STACK_PROFILE" },
    { "type": "text", "label": "Required network providers (optional; e.g. pihole or technitium)", "max": 300, "min": 0, "required": false, "env_variable": "NETWORK_REQUIRED_PROVIDERS" },
    { "type": "text", "label": "Pi-hole URL (optional; for a host or external Pi-hole)", "max": 500, "min": 0, "required": false, "env_variable": "PIHOLE_BASE_URL" },
    { "type": "text", "label": "Technitium DNS URL (optional; for a host or external resolver)", "max": 500, "min": 0, "required": false, "env_variable": "TECHNITIUM_BASE_URL" },
    { "type": "text", "label": "AdGuard Home URL (optional; for a host or external resolver)", "max": 500, "min": 0, "required": false, "env_variable": "ADGUARD_BASE_URL" },
    { "type": "text", "label": "Jellyfin URL (optional; detected automatically when local)", "max": 500, "min": 0, "required": false, "env_variable": "JELLYFIN_BASE_URL" },
    { "type": "password", "label": "Jellyfin read-only API key (optional)", "max": 500, "min": 0, "required": false, "env_variable": "JELLYFIN_API_KEY" },
    { "type": "text", "label": "Plex URL (optional; detected automatically when local)", "max": 500, "min": 0, "required": false, "env_variable": "PLEX_BASE_URL" },
    { "type": "password", "label": "Plex read-only token (optional)", "max": 500, "min": 0, "required": false, "env_variable": "PLEX_TOKEN" },
    { "type": "text", "label": "Crafty URL (optional; use the internal service URL where available)", "max": 500, "min": 0, "required": false, "env_variable": "CRAFTY_BASE_URL" },
    { "type": "password", "label": "Crafty API token (optional)", "max": 500, "min": 0, "required": false, "env_variable": "CRAFTY_API_TOKEN" },
    { "type": "text", "label": "Allow self-signed Crafty TLS: type true only if required (optional)", "max": 5, "min": 0, "required": false, "env_variable": "CRAFTY_ALLOW_INSECURE_TLS" },
    { "type": "text", "label": "Minecraft backend: auto, docker, crafty, pterodactyl, pelican or none (optional)", "max": 24, "min": 0, "required": false, "env_variable": "MINECRAFT_BACKEND" },
    { "type": "text", "label": "Pterodactyl panel URL (optional; API-compatible client endpoint)", "max": 500, "min": 0, "required": false, "env_variable": "PTERODACTYL_BASE_URL" },
    { "type": "password", "label": "Pterodactyl client API token (optional)", "max": 500, "min": 0, "required": false, "env_variable": "PTERODACTYL_API_TOKEN" },
    { "type": "text", "label": "Pelican panel URL (optional; API-compatible client endpoint)", "max": 500, "min": 0, "required": false, "env_variable": "PELICAN_BASE_URL" },
    { "type": "password", "label": "Pelican client API token (optional)", "max": 500, "min": 0, "required": false, "env_variable": "PELICAN_API_TOKEN" },
    { "type": "text", "label": "Default Wake-on-LAN device label (optional)", "max": 48, "min": 0, "required": false, "env_variable": "WAKE_DEFAULT_LABEL" },
    { "type": "text", "label": "Default Wake-on-LAN MAC address (optional)", "max": 20, "min": 0, "required": false, "env_variable": "WAKE_DEFAULT_MAC" },
    { "type": "text", "label": "Wake-on-LAN broadcast address (optional)", "max": 45, "min": 0, "required": false, "env_variable": "WAKE_BROADCAST" },
    { "type": "password", "label": "Weekly report Discord webhook (optional)", "max": 500, "min": 0, "required": false, "env_variable": "WEEKLY_REPORT_WEBHOOK_URL" }
  ]
}
